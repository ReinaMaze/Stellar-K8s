{
  "dashboard": {
    "title": "Stellar Cluster Overview",
    "tags": ["stellar", "cluster", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Cluster Health Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "(sum(stellar_core_node_up) / count(stellar_core_node_up)) * 100",
            "legendFormat": "Node Health %",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "green", "value": 95}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Active Peers",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "avg(stellar_core_network_peers)",
            "legendFormat": "Avg Peers",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "background",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "green", "value": 10}
            ]
          }
        }
      },
      {
        "id": 3,
        "title": "Transactions Per Second (TPS)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "stellar:tps:5m",
            "legendFormat": "TPS (5m avg)",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "showLegend": true,
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "TPS",
              "scaleDistribution": {
                "type": "linear"
              }
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Average Ledger Lag",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "stellar:ledger_lag:avg",
            "legendFormat": "Avg Lag (seconds)",
            "refId": "A"
          },
          {
            "expr": "stellar:ledger_lag:p95",
            "legendFormat": "P95 Lag (seconds)",
            "refId": "B"
          }
        ],
        "options": {
          "legend": {
            "showLegend": true,
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Seconds",
              "scaleDistribution": {
                "type": "linear"
              }
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Quorum Connectivity",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "stellar:quorum_connectivity_percent",
            "legendFormat": "Connectivity %",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          }
        }
      },
      {
        "id": 6,
        "title": "Node Count",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 24},
        "targets": [
          {
            "expr": "count(stellar_core_node_up)",
            "legendFormat": "Total Nodes",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "background"
        }
      },
      {
        "id": 7,
        "title": "Byzantine Fault Tolerance",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "stellar_core_byzantine_fault_tolerance",
            "legendFormat": "BFT Threshold - {{ node_name }}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "showLegend": true,
            "placement": "bottom"
          }
        }
      },
      {
        "id": 8,
        "title": "Operator Uptime",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "stellar_operator_uptime_seconds_total / 3600",
            "legendFormat": "Hours",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "unit": "h"
        }
      },
      {
        "id": 9,
        "title": "Operator Reconciliation Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
        "targets": [
          {
            "expr": "rate(stellar_operator_reconciliation_total[5m])",
            "legendFormat": "Reconciliations/sec - {{ result }}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "showLegend": true,
            "placement": "bottom"
          }
        }
      }
    ]
  }
}
